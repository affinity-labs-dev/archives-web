    F -->|"back tapped"| E
    F -->|"continue tapped"| G["QUESTIONS\nQuiz"]:::checkpoint
    G -->|"back tapped"| F
    G -->|"quiz submitted"| G2["Quiz Results"]
    G2 -->|"continue tapped"| K["Story Completed"]:::checkpoint
    K --> L["Celebration\nScreen"]
