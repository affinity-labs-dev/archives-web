# Environment Configuration for iOS Authentication App
# Copy this file to .env and fill in your actual values

# Clerk Authentication Configuration  
# Get this key from your Clerk dashboard: https://dashboard.clerk.dev/
# Create a new application and copy the "Publishable Key"
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Supabase Configuration (Optional)
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
EXPO_PUBLIC_SUPABASE_URL=https://your_project_id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# PostHog Analytics Configuration
# Get these from your PostHog dashboard: https://eu.posthog.com/
EXPO_PUBLIC_POSTHOG_API_KEY=phc_your_posthog_api_key_here
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Google Gemini AI Configuration (for quiz explanations and chat)
# Get this key from Google AI Studio: https://aistudio.google.com/apikey
# Create a Google account and generate an API key
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Development Notes:
# - All variables with EXPO_PUBLIC_ prefix are available in client-side code
# - Publishable keys and API keys above are safe for client-side use
# - Keep secret keys in your server environment, not here
# - PostHog host can be eu.i.posthog.com (EU) or app.posthog.com (US)
# - Gemini API key should ideally be kept server-side in production
