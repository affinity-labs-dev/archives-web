{
  "expo": {
    "name": "Archives",
    "slug": "archives",
    "version": "3.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "archives",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "ai.affinitylabs.archivesexpo",
      "appleTeamId": "LQ9LP2WW94",
      "buildNumber": "104",
      "associatedDomains": [
        "applinks:link.archiveszone.app",
        "applinks:link.archiveszone.app"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "NSUserTrackingUsageDescription": "Archives uses tracking to provide personalized educational recommendations based on your learning progress and interests, helping you discover relevant historical topics and adventures through our analytics platform.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android_icon.png",
        "backgroundColor": "#F4EBDB"
      },
      "edgeToEdgeEnabled": false,
      "package": "ai.affinitylabs.archivesexpo",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "com.google.android.gms.permission.AD_ID"
      ],
      "versionCode": 25,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "link.archiveszone.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png",
      "name": "Archives",
      "shortName": "Archives",
      "display": "standalone",
      "startUrl": "/",
      "themeColor": "#F4EBDB",
      "backgroundColor": "#F4EBDB",
      "build": {
        "babel": {
          "include": [
            "@react-native-async-storage/async-storage",
            "posthog-react-native"
          ]
        }
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://archives.expo.app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EBDB",
          "image": "./assets/images/splash-icon.png",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#F4EBDB"
          },
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-localization",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-audio",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Archives uses tracking to provide personalized educational recommendations based on your learning progress and interests, helping you discover relevant historical topics and adventures through our analytics platform."
        }
      ],
      "react-native-bottom-tabs",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icon.png",
          "color": "#C99151",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "largeHeap": true
          }
        }
      ],
      "expo-iap",
      "expo-web-browser",
      "expo-font",
      "expo-asset",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "affinity-labs-0i"
        }
      ],
      [
        "customerio-expo-plugin",
        {
          "cdpApiKey": "YOUR_CDP_API_KEY",
          "region": "us",
          "siteId": "YOUR_SITE_ID",
          "ios": {
            "pushNotification": {
              "useRichPush": true,
              "env": "production"
            }
          },
          "android": {
            "googleServicesFile": "./google-services.json"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f1f4bc4-0ced-48f3-b712-178b54175088"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/4f1f4bc4-0ced-48f3-b712-178b54175088"
    },
    "owner": "sunny_panchal"
  }
}
