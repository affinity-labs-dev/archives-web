{
  "expo": {
    "name": "Archives",
    "slug": "archives",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "archives",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "deviceFamily": [1],
      "usesAppleSignIn": true,
      "bundleIdentifier": "ai.affinitylabs.archivesexpo",
      "appleTeamId": "L33CVM28SL",
      "buildNumber": "6",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "deviceFamily": ["phone"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F4EBDB"
      },
      "edgeToEdgeEnabled": true,
      "statusBar": {
        "hidden": false,
        "backgroundColor": "#F4EBDB"
      },
      "navigationBar": {
        "backgroundColor": "#F4EBDB",
        "barStyle": "dark-content"
      },
      "package": "ai.affinitylabs.archivesexpo",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "build": {
        "babel": {
          "include": [
            "@react-native-async-storage/async-storage",
            "posthog-react-native"
          ]
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-localization",
      "expo-video",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f1f4bc4-0ced-48f3-b712-178b54175088"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/4f1f4bc4-0ced-48f3-b712-178b54175088"
    }
  }
}
