{
  "expo": {
    "name": "Archives",
    "slug": "archives",
    "version": "3.5.8",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "archives",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "ai.affinitylabs.archivesexpo",
      "appleTeamId": "LQ9LP2WW94",
      "buildNumber": "178",
      "associatedDomains": [
        "applinks:link.archiveszone.app"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "archives"
            ]
          }
        ],
        "NSUserTrackingUsageDescription": "Archives uses tracking to provide personalized educational recommendations based on your learning progress and interests, helping you discover relevant historical topics and adventures through our analytics platform.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android_icon.png",
        "backgroundColor": "#F4EBDB"
      },
      "edgeToEdgeEnabled": false,
      "package": "ai.affinitylabs.archivesexpo",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "com.google.android.gms.permission.AD_ID"
      ],
      "versionCode": 52,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "link.archiveszone.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Archives",
      "shortName": "Archives",
      "display": "standalone",
      "startUrl": "/",
      "themeColor": "#F4EBDB",
      "backgroundColor": "#F4EBDB",
      "build": {
        "babel": {
          "include": [
            "@react-native-async-storage/async-storage",
            "posthog-react-native"
          ]
        }
      }
    },
    "plugins": [
      "./plugins/withDisableFontScaling",
      [
        "expo-router",
        {
          "origin": "https://archives.expo.app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EBDB",
          "image": "./assets/images/splashscreen.png",
          "dark": {
            "image": "./assets/images/splashscreen.png",
            "backgroundColor": "#F4EBDB"
          },
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Archives needs access to your photos so you can share images with Ibu, your AI learning buddy."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-audio",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Archives uses tracking to provide personalized educational recommendations based on your learning progress and interests, helping you discover relevant historical topics and adventures through our analytics platform."
        }
      ],
      "react-native-bottom-tabs",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icon.png",
          "color": "#C99151",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "largeHeap": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-iap",
      "expo-web-browser",
      "expo-font",
      "expo-asset",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "affinity-labs-0i"
        }
      ],
      [
        "customerio-expo-plugin",
        {
          "config": {
            "cdpApiKey": "66b0dacc49da56e717f5",
            "siteId": "acc28dfeb352f6b3af88",
            "region": "eu"
          },
          "ios": {
            "useFrameworks": "static",
            "pushNotification": {
              "useRichPush": true,
              "showPushAppInForeground": true,
              "disableNotificationRegistration": true,
              "autoFetchDeviceToken": false,
              "handleDeeplinkInKilledState": true
            }
          },
          "android": {
            "googleServicesFile": "./google-services.json",
            "setHighPriorityPushHandler": true,
            "pushClickBehavior": "ActivityPreventRestart",
            "pushNotification": {
              "channel": {
                "id": "archives_notifications",
                "name": "Archives Notifications",
                "importance": 4
              }
            }
          }
        }
      ],
      "expo-secure-store",
      [
        "react-native-fbsdk-next",
        {
          "appID": "1421963112813789",
          "clientToken": "021e8072d5ebfe3e28526cb3254f85eb",
          "displayName": "Archives",
          "scheme": "fb1421963112813789",
          "advertiserIDCollectionEnabled": true,
          "autoLogAppEventsEnabled": true,
          "isAutoInitEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f1f4bc4-0ced-48f3-b712-178b54175088",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "NotificationService",
                  "bundleIdentifier": "ai.affinitylabs.archivesexpo.richpush",
                  "entitlements": {
                    "com.apple.developer.usernotifications.service": true
                  }
                }
              ]
            }
          }
        }
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4f1f4bc4-0ced-48f3-b712-178b54175088"
    },
    "owner": "sunny_panchal"
  }
}
